  "old": "  return cpu.cpuid_sub(13u32, n, 0u32)\n}",
  "new": "  return cpu.cpuid_sub(13u32, n, 1u32)\n}",
  "tests": [
   "tests/cp10_state.py"
  ]
 },
 {
