  "new": "  return cpu.cpuid_sub(13u32, 0u32, 1u32)\n}",
  "tests": [
   "tests/cp10_state.py"
  ]
 },
 {
  "name": "S8 the XSAVE mask drops its high half",
  "file": "examples/storage/cpustate.omni",
  "old": "return bit.or(u64(low), bit.shl(u64(high), 32u32))",
  "new": "return u64(low)",
  "tests": [
   "tests/cp10_state.py"
  ],
  "equivalent": "the supported-state mask of QEMU `max` has no bit above 31, so edx is 0 and the high half contributes nothing observable under TCG; the code path is checked by the architecture (edx:eax)"
 },
 {
  "name": "S9 a component below 2 has a size",
  "file": "examples/storage/cpustate.omni",
  "old": "  if n < 2u32 { return 0u32 }\n  if !has_xsave() { return 0u32 }\n  if max_leaf() < 13u32 { return 0u32 }\n  return cpu.cpuid_sub(13u32, n, 0u32)",
  "new": "  if n < 1u32 { return 0u32 }\n  if !has_xsave() { return 0u32 }\n  if max_leaf() < 13u32 { return 0u32 }\n  return cpu.cpuid_sub(13u32, n, 0u32)",
  "tests": [
   "tests/cp10_state.py"
  ],
  "equivalent": "components 0 and 1 are the legacy and SSE states whose sizes are fixed by the architecture; the guest asks only for component 2, so the boundary between 1 and 2 is not observable from a query for n >= 2"
 },
 {
  "name": "S10 the component size is read from ebx",
