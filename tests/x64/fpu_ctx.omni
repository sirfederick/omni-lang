module t
import rt "rt.omni"

// x87/SSE control state per context (spec/FPU_SSE_STATE_CANDIDATE.md). Two Omni threads run with different MXCSR rounding modes
// (thread 1 toward zero, thread 2 up). Their rounding mode is an observable: (1/3)*3 is below 1.0 toward zero, above 1.0 rounding up.
// The test's scheduler (main) keeps each thread's state in a 512-byte FXSAVE area: it restores the thread's area before switching to
// it and saves it when the thread yields. SysV makes XMM registers caller-saved, so across a cooperative switch the state that must
// travel is the control state; that is what this program checks, 2000 times per thread.
//
// Context areas as in ctx_switch.omni: main 0x540000 (5505024), thread n at +64*n; stack tops 0x3C0000 (3932160) and 0x3B0000 (3866624).
// FXSAVE areas (16-aligned): main 0x541200 (5509632), thread 1 0x541000 (5509120)... see below; current thread cell 0x540100 (5505280);
// results: thread n at 0x540108 + 16*(n-1): [good][mxcsr-correct].  Seeds 1 and 3 at 0x520000 / 0x520008.

func worker() u32 !{memory.raw,cpu.control,port.io} {
  let me u32 = raw.load32(5505280u64)
  let own u64 = 5505024u64 + u64(me) * 64u64
  // the first thing a new context sees is the clean image its scheduler restored (MXCSR 0x1F80), not the creator's or another thread's mode
  let born u32 = raw.store32(5505320u64 + u64(me - 1u32) * 8u64, bit.and(cpu.read_mxcsr(), 65472u32))
  var mode u32 = 32640u32
  if me == 2u32 { mode = 24448u32 }
  let set u32 = cpu.write_mxcsr(mode)
  let a f64 = f64(raw.load32(5373952u64))
  let b f64 = f64(raw.load32(5373960u64))
  var good u32 = 0u32
  var kept u32 = 0u32
  for i in 0u32..2000u32 {
    let p f64 = (a / b) * b
    if me == 1u32 {
      if p < a { good = good + 1u32 }
    }
    if me == 2u32 {
      if p > a { good = good + 1u32 }
    }
    if bit.and(cpu.read_mxcsr(), 65472u32) == mode { kept = kept + 1u32 }
    let y u64 = cpu.switch_context(own, 5505024u64)
  }
  let r1 u32 = raw.store32(5505288u64 + u64(me - 1u32) * 16u64, good)
  let r2 u32 = raw.store32(5505288u64 + u64(me - 1u32) * 16u64 + 8u64, kept)
  let last u64 = cpu.switch_context(own, 5505024u64)
  return rt.finish(77u32)
}

// A clean FXSAVE image: FCW 0x037F, MXCSR 0x1F80, everything else zero (a new context inherits nothing).
func clean_image(area u64) u32 !{memory.raw} {
  let fcw u32 = raw.store32(area, 895u32)
  return raw.store32(area + 24u64, 8064u32)
}

func main() u32 !{io.print,memory.raw,port.io,cpu.control} {
  let seed1 u32 = raw.store32(5373952u64, 1u32)
  let seed3 u32 = raw.store32(5373960u64, 3u32)
  let tr u64 = cpu.thread_trampoline()
  let a1 u32 = raw.store64(3932144u64, tr)
  let a2 u32 = raw.store64(5505088u64 + 48u64, 3932144u64)
  let b1 u32 = raw.store64(3866608u64, tr)
  let b2 u32 = raw.store64(5505152u64 + 48u64, 3866608u64)
  let c1 u32 = clean_image(5509120u64)
  let c2 u32 = clean_image(5509632u64)
  let own u32 = cpu.fxsave(5510144u64)
  for r in 0u32..2001u32 {
    let k1 u32 = raw.store32(5505280u64, 1u32)
    let i1 u32 = cpu.fxrstor(5509120u64)
    let s1 u64 = cpu.switch_context(5505024u64, 5505088u64)
    let o1 u32 = cpu.fxsave(5509120u64)
    let k2 u32 = raw.store32(5505280u64, 2u32)
    let i2 u32 = cpu.fxrstor(5509632u64)
    let s2 u64 = cpu.switch_context(5505024u64, 5505152u64)
    let o2 u32 = cpu.fxsave(5509632u64)
  }
  let back u32 = cpu.fxrstor(5510144u64)
  print(raw.load32(5505288u64))
  print(raw.load32(5505296u64))
  print(raw.load32(5505304u64))
  print(raw.load32(5505312u64))
  print(raw.load32(5505320u64))
  print(raw.load32(5505328u64))
  if bit.and(cpu.read_mxcsr(), 65472u32) == 8064u32 { print(1u32) } else { print(0u32) }
  return rt.finish(0u32)
}
