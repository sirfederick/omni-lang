(!WA2:22(A16:authoring-sourceQ4250:"module mailbox\n\npub struct Producer {\n    m u64;\n}\n\npub struct Consumer {\n    m u64;\n}\n\npub func push<T>(p BorrowMut<Producer>, v T) Result<u32,u32> !{memory.atomic,memory.raw} {\n    let e Producer = resource.peek(p);\n    let base u64 = (e).m;\n    let size u64 = layout.size<T>();\n    let stride u64 = atomic.load64(stride_cell(base), 0);\n    if (size > stride) {\n        return Err<u32, u32>(8);\n    }\n    let cap u64 = atomic.load64(cap_cell(base), 0);\n    let tail u64 = atomic.load64(tail_cell(base), 0);\n    let head u64 = atomic.load64(head_cell(base), 1);\n    if (head > tail) {\n        return Err<u32, u32>(12);\n    }\n    if ((tail - head) > cap) {\n        return Err<u32, u32>(12);\n    }\n    if ((tail - head) == cap) {\n        return Err<u32, u32>(15);\n    }\n    let w u32 = raw.write<T>((slots(base) + (bit.and(tail, (cap - 1u64)) * stride)), v);\n    let s u32 = atomic.store64(tail_cell(base), (tail + 1u64), 2);\n    return Ok<u32, u32>(1);\n}\n\npub func pop<T>(c BorrowMut<Consumer>) Result<T,u32> !{memory.atomic,memory.raw} {\n    let e Consumer = resource.peek(c);\n    let base u64 = (e).m;\n    let size u64 = layout.size<T>();\n    let stride u64 = atomic.load64(stride_cell(base), 0);\n    if (size > stride) {\n        return Err<T, u32>(8);\n    }\n    let cap u64 = atomic.load64(cap_cell(base), 0);\n    let head u64 = atomic.load64(head_cell(base), 0);\n    let tail u64 = atomic.load64(tail_cell(base), 1);\n    if (head > tail) {\n        return Err<T, u32>(12);\n    }\n    if ((tail - head) > cap) {\n        return Err<T, u32>(12);\n    }\n    if (head == tail) {\n        return Err<T, u32>(16);\n    }\n    let v T = raw.read<T>((slots(base) + (bit.and(head, (cap - 1u64)) * stride)));\n    let s u32 = atomic.store64(head_cell(base), (head + 1u64), 2);\n    return Ok<T, u32>(v);\n}\n\nfunc magic() u64 !pure {\n    return 5714309578938797912u64;\n}\n\nfunc max64() u64 !pure {\n    return 18446744073709551615u64;\n}\n\nfunc cap_cell(b u64) u64 !pure {\n    return (b + 64u64);\n}\n\nfunc stride_cell(b u64) u64 !pure {\n    return (b + 128u64);\n}\n\nfunc tail_cell(b u64) u64 !pure {\n    return (b + 192u64);\n}\n\nfunc head_cell(b u64) u64 !pure {\n    return (b + 256u64);\n}\n\nfunc claim_p(b u64) u64 !pure {\n    return (b + 320u64);\n}\n\nfunc claim_c(b u64) u64 !pure {\n    return (b + 384u64);\n}\n\nfunc slots(b u64) u64 !pure {\n    return (b + 448u64);\n}\n\npub func create(base u64, capacity u64, stride u64) Result<u32,u32> !{memory.atomic,memory.raw} {\n    if (base == 0u64) {\n        return Err<u32, u32>(5);\n    }\n    if (bit.and(base, 63u64) != 0u64) {\n        return Err<u32, u32>(5);\n    }\n    if (capacity == 0u64) {\n        return Err<u32, u32>(5);\n    }\n    if (capacity > 1048576u64) {\n        return Err<u32, u32>(5);\n    }\n    if (bit.and(capacity, (capacity - 1u64)) != 0u64) {\n        return Err<u32, u32>(5);\n    }\n    if (stride < 8u64) {\n        return Err<u32, u32>(5);\n    }\n    if (stride > 4096u64) {\n        return Err<u32, u32>(5);\n    }\n    if (bit.and(stride, 7u64) != 0u64) {\n        return Err<u32, u32>(5);\n    }\n    if (base > (max64() - 448u64)) {\n        return Err<u32, u32>(6);\n    }\n    if ((capacity * stride) > ((max64() - base) - 448u64)) {\n        return Err<u32, u32>(6);\n    }\n    if (atomic.load64(base, 1) == magic()) {\n        if (atomic.load32(claim_p(base), 1) != 0) {\n            return Err<u32, u32>(14);\n        }\n        if (atomic.load32(claim_c(base), 1) != 0) {\n            return Err<u32, u32>(14);\n        }\n    }\n    let a u32 = atomic.store64(cap_cell(base), capacity, 0);\n    let b u32 = atomic.store64(stride_cell(base), stride, 0);\n    let c u32 = atomic.store64(tail_cell(base), 0u64, 0);\n    let d u32 = atomic.store64(head_cell(base), 0u64, 0);\n    let e u32 = atomic.store32(claim_p(base), 0, 0);\n    let f u32 = atomic.store32(claim_c(base), 0, 0);\n    let g u32 = atomic.store64(base, magic(), 2);\n    return Ok<u32, u32>(1);\n}\n\nfunc formatted(base u64) bool !{memory.atomic} {\n    if (bit.and(base, 63u64) != 0u64) {\n        return false;\n    }\n    if (base == 0u64) {\n        return false;\n    }\n    return (atomic.load64(base, 1) == magic("Q1758:"));\n}\n\npub func open_producer(base u64) Result<Resource<Producer>,u32> !{memory.atomic} {\n    if (formatted(base) == false) {\n        return Err<Resource<Producer>, u32>(13);\n    }\n    let seen u32 = atomic.cas32(claim_p(base), 0, 1, 3, 1);\n    if (seen != 0) {\n        return Err<Resource<Producer>, u32>(14);\n    }\n    return Ok<Resource<Producer>, u32>(resource.seal(Producer { m: base }));\n}\n\npub func open_consumer(base u64) Result<Resource<Consumer>,u32> !{memory.atomic} {\n    if (formatted(base) == false) {\n        return Err<Resource<Consumer>, u32>(13);\n    }\n    let seen u32 = atomic.cas32(claim_c(base), 0, 1, 3, 1);\n    if (seen != 0) {\n        return Err<Resource<Consumer>, u32>(14);\n    }\n    return Ok<Resource<Consumer>, u32>(resource.seal(Consumer { m: base }));\n}\n\npub func close_producer(p Resource<Producer>) u32 !{memory.atomic} {\n    let e Producer = resource.unseal(move(p));\n    return atomic.store32(claim_p((e).m), 0, 2);\n}\n\npub func close_consumer(c Resource<Consumer>) u32 !{memory.atomic} {\n    let e Consumer = resource.unseal(move(c));\n    return atomic.store32(claim_c((e).m), 0, 2);\n}\n\npub func pending_p(p Borrow<Producer>) u64 !{memory.atomic} {\n    let e Producer = resource.peek(p);\n    let head u64 = atomic.load64(head_cell((e).m), 1);\n    let tail u64 = atomic.load64(tail_cell((e).m), 0);\n    if (head > tail) {\n        return 0u64;\n    }\n    return (tail - head);\n}\n\npub func pending_c(c Borrow<Consumer>) u64 !{memory.atomic} {\n    let e Consumer = resource.peek(c);\n    let tail u64 = atomic.load64(tail_cell((e).m), 1);\n    let head u64 = atomic.load64(head_cell((e).m), 0);\n    if (head > tail) {\n        return 0u64;\n    }\n    return (tail - head);\n}\n"))
