Csha256:e0915d67643d52162cbebe4fc19edec4cd02cf6d12f25090d4ad805f5f95f2f6
(!WA2:22(A16:authoring-sourceQ4217:"bundle vec {\n    module alloc {\n\n        pub struct Heap {\n            tag u32;\n        }\n\n        pub trait Allocator {\n            func allocate(bytes u32) Result<Resource<Buffer>,u32> !{memory.write}\n            func resize(b BorrowMut<Buffer>, bytes u32) Result<u32,u32> !{memory.write}\n            func release(b Resource<Buffer>) u32 !{memory.write}\n        }\n\n        impl Allocator for Heap {\n        func allocate(bytes u32) Result<Resource<Buffer>,u32> !{memory.write} {\n            return buffer.alloc(bytes);\n        }\n\n        func resize(b BorrowMut<Buffer>, bytes u32) Result<u32,u32> !{memory.write} {\n            return buffer.grow(b, bytes);\n        }\n\n        func release(b Resource<Buffer>) u32 !{memory.write} {\n            return buffer.release(move(b));\n        }\n        }\n    }\n    module vec {\n        import alloc = alloc;\n\n        pub struct Vec<T:Codec,A:alloc.Allocator> {\n            buf Resource<Buffer>;\n        }\n\n        pub trait Codec {\n            func size() u32 !pure\n            func put(b BorrowMut<Buffer>, off u32, v Self) Result<u32,u32> !{memory.write}\n            func get(b Borrow<Buffer>, off u32) Result<Self,u32> !{memory.read}\n        }\n\n        impl Codec for u32 {\n        func size() u32 !pure {\n            return 4;\n        }\n\n        func put(b BorrowMut<Buffer>, off u32, v u32) Result<u32,u32> !{memory.write} {\n            return buffer.write_u32le(b, off, v);\n        }\n\n        func get(b Borrow<Buffer>, off u32) Result<u32,u32> !{memory.read} {\n            return buffer.read_u32le(b, off);\n        }\n        }\n\n        impl Codec for u64 {\n        func size() u32 !pure {\n            return 8;\n        }\n\n        func put(b BorrowMut<Buffer>, off u32, v u64) Result<u32,u32> !{memory.write} {\n            return buffer.write_u64le(b, off, v);\n        }\n\n        func get(b Borrow<Buffer>, off u32) Result<u64,u32> !{memory.read} {\n            return buffer.read_u64le(b, off);\n        }\n        }\n\n        pub func new<T:Codec,A:alloc.Allocator>(capacity u32) Result<Resource<Vec<T,A>>,u32> !{memory.read,memory.write} {\n            let size u32 = Codec.size<T>();\n            if (capacity > max_elements(size)) {\n                return Err<Resource<Vec<T,A>>, u32>(1);\n            }\n            let a = alloc.Allocator.allocate<A>((header_bytes() + (capacity * size)));\n            match a {\n                Ok(b) {\n                    let inner Vec<T,A> = Vec<T,A> { buf: move(b) };\n                    return Ok<Resource<Vec<T,A>>, u32>(resource.seal(move(inner)));\n                }\n                Err(code) {\n                    return Err<Resource<Vec<T,A>>, u32>(code);\n                }\n            }\n        }\n\n        pub func len<T:Codec,A:alloc.Allocator>(v Borrow<Vec<T,A>>) u32 !{memory.read} {\n            let r = buffer.read_u32le(resource.inner(v), 0);\n            match r {\n                Ok(n) {\n                    return n;\n                }\n                Err(code) {\n                    return 0;\n                }\n            }\n        }\n\n        pub func capacity<T:Codec,A:alloc.Allocator>(v Borrow<Vec<T,A>>) u32 !{memory.read} {\n            return ((buffer.len(resource.inner(v)) - header_bytes()) / Codec.size<T>());\n        }\n\n        pub func get<T:Codec,A:alloc.Allocator>(v Borrow<Vec<T,A>>, index u32) Result<T,u32> !{memory.read} {\n            if (index >= len<T, A>(v)) {\n                return Err<T, u32>(10);\n            }\n            return Codec.get<T>(resource.inner(v), (header_bytes() + (index * Codec.size<T>())));\n        }\n\n        pub func set<T:Codec,A:alloc.Allocator>(v BorrowMut<Vec<T,A>>, index u32, x T) Result<u32,u32> !{memory.read,memory.write} {\n            if (index >= len<T, A>(borrow(v))) {\n                return Err<u32, u32>(10);\n            }\n            return Codec.put<T>(resource.inner_mut(v), (header_bytes() + (index * Codec.size<T>())), x);\n        }\n\n        func store_len<T:Codec,A:alloc.Allocator>(v BorrowMut<Vec<T,A>>, n u32) Result<u32,u32> !{memory.write} {\n            return buffer.write_u32le(resource.inner_mut(v), 0, n);\n        }\n\n        "Q4083:"func grow_for_one<T:Codec,A:alloc.Allocator>(v BorrowMut<Vec<T,A>>, count u32) Result<u32,u32> !{memory.read,memory.write} {\n            let size u32 = Codec.size<T>();\n            let cap u32 = capacity<T, A>(borrow(v));\n            if (count < cap) {\n                return Ok<u32, u32>(cap);\n            }\n            if (count >= max_elements(size)) {\n                return Err<u32, u32>(1);\n            }\n            var want u32 = (cap * 2);\n            if (want < 4) {\n                want = 4;\n            }\n            if (want > max_elements(size)) {\n                want = max_elements(size);\n            }\n            let grown = alloc.Allocator.resize<A>(resource.inner_mut(v), (header_bytes() + (want * size)));\n            match grown {\n                Ok(n) {\n                    return Ok<u32, u32>(want);\n                }\n                Err(code) {\n                    return Err<u32, u32>(code);\n                }\n            }\n        }\n\n        pub func push<T:Codec,A:alloc.Allocator>(v BorrowMut<Vec<T,A>>, x T) Result<u32,u32> !{memory.read,memory.write} {\n            let count u32 = len<T, A>(borrow(v));\n            let room = grow_for_one<T, A>(v, count);\n            match room {\n                Ok(cap) {\n                    let w = Codec.put<T>(resource.inner_mut(v), (header_bytes() + (count * Codec.size<T>())), x);\n                    match w {\n                        Ok(done) {\n                            let n = store_len<T, A>(v, (count + 1));\n                            match n {\n                                Ok(d) {\n                                    return Ok<u32, u32>((count + 1));\n                                }\n                                Err(code) {\n                                    return Err<u32, u32>(code);\n                                }\n                            }\n                        }\n                        Err(code) {\n                            return Err<u32, u32>(code);\n                        }\n                    }\n                }\n                Err(code) {\n                    return Err<u32, u32>(code);\n                }\n            }\n        }\n\n        pub func pop<T:Codec,A:alloc.Allocator>(v BorrowMut<Vec<T,A>>) Result<T,u32> !{memory.read,memory.write} {\n            let count u32 = len<T, A>(borrow(v));\n            if (count == 0) {\n                return Err<T, u32>(11);\n            }\n            let size u32 = Codec.size<T>();\n            let last = Codec.get<T>(resource.inner(v), (header_bytes() + ((count - 1) * size)));\n            match last {\n                Ok(x) {\n                    let z = buffer.zero(resource.inner_mut(v), (header_bytes() + ((count - 1) * size)), size);\n                    match z {\n                        Ok(d) {\n                            let n = store_len<T, A>(v, (count - 1));\n                            match n {\n                                Ok(e) {\n                                    return Ok<T, u32>(x);\n                                }\n                                Err(code) {\n                                    return Err<T, u32>(code);\n                                }\n                            }\n                        }\n                        Err(code) {\n                            return Err<T, u32>(code);\n                        }\n                    }\n                }\n                Err(code) {\n                    return Err<T, u32>(code);\n                }\n            }\n        }\n\n        pub func destroy<T:Codec,A:alloc.Allocator>(v Resource<Vec<T,A>>) u32 !{memory.write} {\n            let inner Vec<T,A> = resource.unseal(move(v));\n            return alloc.Allocator.release<A>(move((inner).buf));\n        }\n\n        func header_bytes() u32 !pure {\n            return 8;\n        }\n\n        func limit_bytes() u32 !pure {\n            return 1048576;\n        }\n\n        func max_elements(size u32) u32 !pure {\n            return ((limit_bytes() - header_bytes()) / size);\n        }\n    }\n}\n"))
