(!WA2:22(A16:authoring-sourceQ314:"module t\n\nfunc f<T>(v Option<T>) Option<T> !pure {\n    let marker = 1;\n    let x = (v)?;\n    return Some<T>(x);\n}\n\nfunc main() u32 !pure {\n    let o = f<u32>(Some<u32>(42));\n    match o {\n        Some(x) {\n            return x;\n        }\n        None {\n            return 0;\n        }\n    }\n}\n"))
