module data_control

enum Boxed {
  Value(u32),
  Empty,
}

func main() u32 !{io.print} {
  let pair Tuple<u32,u32> = tuple(3u32,7u32)
  let (a,b) = pair

  let values Array<u32,4> = array(10u32,20u32,30u32,40u32)
  let second u32 = values[1u32]
  let values_view View<u32> = view(values)
  let third u32 = values_view[2u32]

  var sum u32 = 0u32
  for item in values {
    if item==20u32 { continue }
    if item==40u32 { break }
    sum = sum + item
  }

  let result Result<u32,u32> = Ok<u32,u32>(99u32)
  match result {
    Ok(_) { }
    Err(e) { return e }
  }

  let boxed Boxed = Boxed.Value(123u32)
  match boxed {
    Value(_) { }
    Empty { }
  }

  print(sum)
  return a+b+second+third+sum
}
