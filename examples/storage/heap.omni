module heap

// CP-04 / row 4.9 (spec/DYNAMIC_STORAGE_CANDIDATE.md): a typed heap with individual release, written in Omni over a RAW MEMORY RANGE. It needs no host buffer, no
// libc and no Core allocator: the platform hands over [base, base + size) and gets it back from `destroy`. `region.omni` is the arena (everything is released at once);
// this is the allocator that frees one block at a time, reuses the space and merges neighbours, for the profiles where `buffer.grow` does not exist (E_TARGET_PROFILE).
//   header (64 bytes at base): magic, brk (end of the carved area), limit (end of the range), serial (last allocation number), free_head, live (blocks handed out), 2 spare
//   a block is a 16-byte head { size, tag } followed by `size` payload bytes (a multiple of 16, at least 16); the payload is 16-aligned, so every type of alignment <= 16 fits
//   a free block keeps the address of the next free block in its first payload word; the free list is ordered by address, so a block that is freed is merged with its free
//   neighbours, and a free block that touches `brk` goes back to the untouched part of the range (brk retreats)
// OWNERSHIP MODEL (prompt 008, design A). The range has ONE owner: `Resource<Heap>` is a nominal affine resource, sealed in this module, handed over by `create` and consumed
// by `destroy` exactly once; the platform's raw range is the only thing the library does not create. A `Block<T>` is NOT an owner: it is a plain, copyable DESCRIPTOR
// { address, count, serial } of one block, like `region.Slot<T>`. It claims nothing, so two copies of it are two descriptors of the same block, and what protects the block is
// that EVERY operation that touches bytes takes a borrow of the heap and revalidates the descriptor (magic, range, alignment, tag/serial in the block head, size) before it
// reads or writes: a descriptor of a released block, of a block that was reused (same address, new serial), of another heap (its address is outside this range) or forged
// from numbers is a typed error, never an access. `free` is the revocation: after it every descriptor of the block is stale. The safe API gives a program no way to get the
// address of a block it does not hold a descriptor for. That is the guarantee against code that uses the API; against code that holds `memory.raw` and writes the heap's own
// bytes (or forges a descriptor with the right serial) the library keeps its structure checkable (every walk bounds-checks what it reads) but does not claim isolation:
// `memory.raw` is a capability, not a sandbox. A library that wants ONE owner for a block (rvec) keeps the block's address inside its own sealed resource and rebuilds the
// descriptor with `descriptor_at`, which proves that a live block starts at that address and nothing else (see there).
// Ranges: the heap cannot know whether the platform handed the same bytes to someone else (there is no registry of ranges); two heaps over overlapping ranges, or a heap over
// memory that another owner uses, break the contract of `create`. Serial numbers continue across incarnations of a range: `destroy` leaves a retired mark and the last serial in
// the header, `create` over such a mark starts after it (a descriptor of an earlier heap on the same bytes stays stale) and refuses a range whose serials are exhausted (9).
// Every allocation gets a new serial number; the tag in the head of a live block is that serial mixed with a constant, and a free block has tag 0. A handle (`Block<T>`)
// carries the serial, so a double free, a use after free and a handle of a block that was reused are typed errors. The check is exact for a block whose head still marks the
// boundary; for a block that was absorbed by a merge and is now inside a live block, a stale handle is detected unless that block holds, at the head position, the 64-bit
// tag of the stale handle (a program would have to write that exact value).
// Every payload is zero when handed out and is zeroed again when released or when the heap is destroyed. A live block is never moved by the heap itself: `realloc_array`
// allocates the larger block, copies the elements, and only then releases the old one, so a failing call changes nothing.
// Outcome codes (a failing call changes neither the header, nor the free list, nor memory):
//   1 the range is exhausted (typed out-of-memory)   4 stale or unknown block   5 bad range handed to create/extend   6 size/address arithmetic would overflow
//   7 index outside the block (or realloc to fewer elements)   8 alignment: the element type needs more than 16, or the handle address is not 16-aligned
//   9 serial counter exhausted   10 header corrupt (magic mismatch)   11 the handle claims more bytes than the block has
//   12 free list or block head corrupt (damage detected while walking, never followed)
struct Header { magic u64, brk u64, limit u64, serial u64, free_head u64, live u64, spare0 u64, spare1 u64 }
struct Head { size u64, tag u64 }

pub struct Heap { h u64 }
pub struct Block<T> { addr u64, count u64, serial u64 }

func magic() u64 { return 5714309578855104848u64 }
func retired() u64 { return 5714309578822403397u64 }
func tag_mask() u64 { return 6840399175121563661u64 }
func serial_max() u64 { return 6840399175121563660u64 }
func max64() u64 { return 18446744073709551615u64 }

func header(base u64) Header !{memory.raw} { return raw.read<Header>(base) }
func tag_of(serial u64) u64 { return bit.xor(serial, tag_mask()) }

// First payload address of the range: the head of the first block starts 64 bytes after base.
func first_payload(base u64) u64 { return base + 80u64 }

// Creates a heap over [base, base + size). base must be a non-zero multiple of 16 and size at least 128; the range must not wrap.
pub func create(base u64, size u64) Result<Resource<Heap>,u32> !{memory.raw} {
  if base == 0u64 { return Err<Resource<Heap>,u32>(5u32) }
  if bit.and(base, 15u64) != 0u64 { return Err<Resource<Heap>,u32>(5u32) }
  if size < 128u64 { return Err<Resource<Heap>,u32>(5u32) }
  if size > max64() - base { return Err<Resource<Heap>,u32>(6u32) }
  let old Header = header(base)
  var first u64 = 0u64
  if old.magic == retired() {
    if old.serial >= serial_max() { return Err<Resource<Heap>,u32>(9u32) }
    first = old.serial
  }
  let w u32 = raw.write<Header>(base, Header { magic: magic(), brk: base + 64u64, limit: base + size, serial: first, free_head: 0u64, live: 0u64, spare0: 0u64, spare1: 0u64 })
  return Ok<Resource<Heap>,u32>(resource.seal(Heap { h: base }))
}

// Number of blocks handed out and not released.
pub func live(hp Borrow<Heap>) u64 !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  return h.live
}

// Bytes of the range that were never carved into a block.
pub func remaining(hp Borrow<Heap>) u64 !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  return h.limit - h.brk
}

// Bytes between the first block and the end of the carved area (live blocks, free blocks and their heads).
pub func carved(hp Borrow<Heap>) u64 !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  return h.brk - v.h - 64u64
}

// Number of free blocks that are waiting for reuse (0 when the free list is damaged).
pub func free_blocks(hp Borrow<Heap>) u64 !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  let lo u64 = first_payload(v.h)
  var n u64 = 0u64
  var prev u64 = 0u64
  var cur u64 = h.free_head
  var bad bool = false
  for cur != 0u64 && bad == false {
    if cur < lo || cur >= h.brk || bit.and(cur, 15u64) != 0u64 || cur <= prev { bad = true }
    if bad == false {
      n = n + 1u64
      prev = cur
      cur = raw.load64(cur)
    }
  }
  if bad { return 0u64 }
  return n
}

// Payload bytes of the free blocks (0 when the free list is damaged).
pub func free_bytes(hp Borrow<Heap>) u64 !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  let lo u64 = first_payload(v.h)
  var total u64 = 0u64
  var prev u64 = 0u64
  var cur u64 = h.free_head
  var bad bool = false
  for cur != 0u64 && bad == false {
    if cur < lo || cur >= h.brk || bit.and(cur, 15u64) != 0u64 || cur <= prev { bad = true }
    if bad == false {
      let hd Head = raw.read<Head>(cur - 16u64)
      if hd.size > h.brk - cur { bad = true }
      if bad == false {
        total = total + hd.size
        prev = cur
        cur = raw.load64(cur)
      }
    }
  }
  if bad { return 0u64 }
  return total
}

func scrub(from u64, to u64) u32 !{memory.raw} {
  var p u64 = from
  for p < to {
    let z u32 = raw.store64(p, 0u64)
    p = p + 8u64
  }
  return 0u32
}

// Validates a handle against the head of its block. `bytes` is what the handle claims to own.
func check(h Header, lo u64, addr u64, serial u64, bytes u64) u32 !{memory.raw} {
  if h.magic != magic() { return 10u32 }
  if serial == 0u64 { return 4u32 }
  if bit.and(addr, 15u64) != 0u64 { return 8u32 }
  if addr < lo { return 4u32 }
  if addr >= h.brk { return 4u32 }
  let hd Head = raw.read<Head>(addr - 16u64)
  if hd.tag != tag_of(serial) { return 4u32 }
  if hd.size > h.brk - addr { return 12u32 }
  if bytes > hd.size { return 11u32 }
  return 0u32
}

// Reserves `count` elements of T (count may be 0) and returns the zeroed block. First fit over the free list, then the untouched part of the range.
pub func alloc_array<T>(hp BorrowMut<Heap>, count u64) Result<Block<T>,u32> !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  if h.magic != magic() { return Err<Block<T>,u32>(10u32) }
  if layout.align<T>() > 16u64 { return Err<Block<T>,u32>(8u32) }
  let size u64 = layout.size<T>()
  if count > max64() / size { return Err<Block<T>,u32>(6u32) }
  let bytes u64 = count * size
  if bytes > max64() - 15u64 { return Err<Block<T>,u32>(6u32) }
  var need u64 = bit.and(bytes + 15u64, bit.not(15u64))
  if need < 16u64 { need = 16u64 }
  if h.serial >= serial_max() { return Err<Block<T>,u32>(9u32) }
  let serial u64 = h.serial + 1u64
  let lo u64 = first_payload(v.h)
  var prev u64 = 0u64
  var cur u64 = h.free_head
  var hit u64 = 0u64
  var bad bool = false
  for cur != 0u64 && hit == 0u64 && bad == false {
    if cur < lo || cur >= h.brk || bit.and(cur, 15u64) != 0u64 || cur <= prev { bad = true }
    if bad == false {
      let hd Head = raw.read<Head>(cur - 16u64)
      if hd.size > h.brk - cur || bit.and(hd.size, 15u64) != 0u64 { bad = true }
      if bad == false {
        if hd.size >= need { hit = cur }
        if hit == 0u64 {
          prev = cur
          cur = raw.load64(cur)
        }
      }
    }
  }
  if bad { return Err<Block<T>,u32>(12u32) }
  if hit != 0u64 {
    let hd Head = raw.read<Head>(hit - 16u64)
    let after u64 = raw.load64(hit)
    var link u64 = after
    var used u64 = hd.size
    if hd.size - need >= 32u64 {
      let rest u64 = hit + need + 16u64
      let a u32 = raw.write<Head>(rest - 16u64, Head { size: hd.size - need - 16u64, tag: 0u64 })
      let b u32 = raw.store64(rest, after)
      link = rest
      used = need
    }
    var head u64 = h.free_head
    if prev == 0u64 { head = link }
    if prev != 0u64 { let c u32 = raw.store64(prev, link) }
    let d u32 = raw.write<Head>(hit - 16u64, Head { size: used, tag: tag_of(serial) })
    let e u32 = scrub(hit, hit + used)
    let w u32 = raw.write<Header>(v.h, Header { magic: h.magic, brk: h.brk, limit: h.limit, serial: serial, free_head: head, live: h.live + 1u64, spare0: 0u64, spare1: 0u64 })
    return Ok<Block<T>,u32>(Block<T> { addr: hit, count: count, serial: serial })
  }
  let at u64 = h.brk + 16u64
  if need > max64() - at { return Err<Block<T>,u32>(6u32) }
  let end u64 = at + need
  if end > h.limit { return Err<Block<T>,u32>(1u32) }
  let d u32 = raw.write<Head>(h.brk, Head { size: need, tag: tag_of(serial) })
  let e u32 = scrub(at, end)
  let w u32 = raw.write<Header>(v.h, Header { magic: h.magic, brk: end, limit: h.limit, serial: serial, free_head: h.free_head, live: h.live + 1u64, spare0: 0u64, spare1: 0u64 })
  return Ok<Block<T>,u32>(Block<T> { addr: at, count: count, serial: serial })
}

// The descriptor of the live block that starts at `addr`, rebuilt from the address alone (the serial is recovered from the tag in the block head). It proves that a live block
// of this heap starts there and that `count` elements fit in it; it does NOT prove who owns the block and it creates no owner: the result is as copyable as any descriptor.
// It is for a library that keeps the address inside its own sealed resource (rvec): the exclusivity of that block is the library's, through the resource that nobody else can
// build or open, and a program that has no descriptor and does not forge addresses cannot reach it. Answers 4 for an address that is not the payload of a live block, 8 for
// an unaligned one, 11 if `count` elements do not fit, 10/12 for damage.
pub func descriptor_at<T>(hp Borrow<Heap>, addr u64, count u64) Result<Block<T>,u32> !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  let lo u64 = first_payload(v.h)
  if h.magic != magic() { return Err<Block<T>,u32>(10u32) }
  if bit.and(addr, 15u64) != 0u64 { return Err<Block<T>,u32>(8u32) }
  if addr < lo || addr >= h.brk { return Err<Block<T>,u32>(4u32) }
  let hd Head = raw.read<Head>(addr - 16u64)
  let serial u64 = bit.xor(hd.tag, tag_mask())
  if serial == 0u64 || serial > h.serial { return Err<Block<T>,u32>(4u32) }
  let size u64 = layout.size<T>()
  if count > max64() / size { return Err<Block<T>,u32>(6u32) }
  let c u32 = check(h, lo, addr, serial, count * size)
  if c != 0u32 { return Err<Block<T>,u32>(c) }
  return Ok<Block<T>,u32>(Block<T> { addr: addr, count: count, serial: serial })
}

pub func alloc<T>(hp BorrowMut<Heap>) Result<Block<T>,u32> !{memory.raw} {
  return alloc_array<T>(hp, 1u64)
}

func index_check<T>(h Header, lo u64, b Block<T>, index u64) u32 !{memory.raw} {
  let size u64 = layout.size<T>()
  if b.count > max64() / size { return 6u32 }
  let c u32 = check(h, lo, b.addr, b.serial, b.count * size)
  if c != 0u32 { return c }
  if index >= b.count { return 7u32 }
  return 0u32
}

pub func store_at<T>(hp Borrow<Heap>, b Block<T>, index u64, value T) Result<u32,u32> !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  let c u32 = index_check<T>(h, first_payload(v.h), b, index)
  if c != 0u32 { return Err<u32,u32>(c) }
  let w u32 = raw.write<T>(b.addr + index * layout.size<T>(), value)
  return Ok<u32,u32>(1u32)
}

pub func load_at<T>(hp Borrow<Heap>, b Block<T>, index u64) Result<T,u32> !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  let c u32 = index_check<T>(h, first_payload(v.h), b, index)
  if c != 0u32 { return Err<T,u32>(c) }
  return Ok<T,u32>(raw.read<T>(b.addr + index * layout.size<T>()))
}

pub func store<T>(hp Borrow<Heap>, b Block<T>, value T) Result<u32,u32> !{memory.raw} {
  return store_at<T>(hp, b, 0u64, value)
}

pub func load<T>(hp Borrow<Heap>, b Block<T>) Result<T,u32> !{memory.raw} {
  return load_at<T>(hp, b, 0u64)
}

// Releases a block: the payload is zeroed, the block joins the free list (merged with a free neighbour on either side) or, when it touches the end of the carved area,
// goes back to the untouched part of the range. Releasing the same handle again, or a handle of a block that was reused, answers 4.
pub func free<T>(hp BorrowMut<Heap>, b Block<T>) Result<u32,u32> !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  let lo u64 = first_payload(v.h)
  let size u64 = layout.size<T>()
  if b.count > max64() / size { return Err<u32,u32>(6u32) }
  let c u32 = check(h, lo, b.addr, b.serial, b.count * size)
  if c != 0u32 { return Err<u32,u32>(c) }
  if h.live == 0u64 { return Err<u32,u32>(12u32) }
  let hd Head = raw.read<Head>(b.addr - 16u64)
  var pp u64 = 0u64
  var prev u64 = 0u64
  var nxt u64 = h.free_head
  var stop bool = false
  var bad bool = false
  for nxt != 0u64 && stop == false && bad == false {
    if nxt < lo || nxt >= h.brk || bit.and(nxt, 15u64) != 0u64 || nxt <= prev { bad = true }
    if bad == false {
      if nxt > b.addr { stop = true }
      if stop == false {
        pp = prev
        prev = nxt
        nxt = raw.load64(nxt)
      }
    }
  }
  if bad { return Err<u32,u32>(12u32) }
  var m u64 = b.addr
  var ms u64 = hd.size
  var before u64 = prev
  var after u64 = nxt
  var merge_next bool = false
  var merge_prev bool = false
  if nxt != 0u64 && b.addr + hd.size + 16u64 == nxt {
    let nh Head = raw.read<Head>(nxt - 16u64)
    if nh.size > h.brk - nxt || bit.and(nh.size, 15u64) != 0u64 { return Err<u32,u32>(12u32) }
    merge_next = true
    ms = ms + 16u64 + nh.size
    after = raw.load64(nxt)
  }
  if prev != 0u64 {
    let ph Head = raw.read<Head>(prev - 16u64)
    if ph.size > h.brk - prev || bit.and(ph.size, 15u64) != 0u64 { return Err<u32,u32>(12u32) }
    if prev + ph.size + 16u64 == b.addr {
      merge_prev = true
      m = prev
      ms = ph.size + 16u64 + ms
      before = pp
    }
  }
  let top bool = m + ms == h.brk
  if top && after != 0u64 { return Err<u32,u32>(12u32) }
  // from here on nothing can fail: the writes below are the whole effect of the call
  let z0 u32 = scrub(b.addr, b.addr + hd.size)
  if merge_next {
    let z1 u32 = raw.store64(nxt - 16u64, 0u64)
    let z2 u32 = raw.store64(nxt - 8u64, 0u64)
    let z3 u32 = raw.store64(nxt, 0u64)
  }
  if merge_prev {
    let z4 u32 = raw.store64(b.addr - 16u64, 0u64)
    let z5 u32 = raw.store64(b.addr - 8u64, 0u64)
  }
  var head u64 = h.free_head
  var brk u64 = h.brk
  if top {
    brk = m - 16u64
    let z6 u32 = raw.store64(m - 16u64, 0u64)
    let z7 u32 = raw.store64(m - 8u64, 0u64)
    let z8 u32 = raw.store64(m, 0u64)
    if before == 0u64 { head = 0u64 }
    if before != 0u64 { let z9 u32 = raw.store64(before, 0u64) }
  }
  if top == false {
    let y0 u32 = raw.write<Head>(m - 16u64, Head { size: ms, tag: 0u64 })
    let y1 u32 = raw.store64(m, after)
    if before == 0u64 { head = m }
    if before != 0u64 { let y2 u32 = raw.store64(before, m) }
  }
  let w u32 = raw.write<Header>(v.h, Header { magic: h.magic, brk: brk, limit: h.limit, serial: h.serial, free_head: head, live: h.live - 1u64, spare0: 0u64, spare1: 0u64 })
  return Ok<u32,u32>(1u32)
}

// Grows a block to `count` elements: a larger block is allocated, the elements are copied and the old block is released. The handle that comes back replaces the old one;
// if the block already has room for `count` elements it is the same block with the new count. A failing call leaves the old block, the free list and the memory as they were.
pub func realloc_array<T>(hp BorrowMut<Heap>, b Block<T>, count u64) Result<Block<T>,u32> !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  let size u64 = layout.size<T>()
  if b.count > max64() / size { return Err<Block<T>,u32>(6u32) }
  let c u32 = check(h, first_payload(v.h), b.addr, b.serial, b.count * size)
  if c != 0u32 { return Err<Block<T>,u32>(c) }
  if count < b.count { return Err<Block<T>,u32>(7u32) }
  if count > max64() / size { return Err<Block<T>,u32>(6u32) }
  let hd Head = raw.read<Head>(b.addr - 16u64)
  if count * size <= hd.size { return Ok<Block<T>,u32>(Block<T> { addr: b.addr, count: count, serial: b.serial }) }
  let made = alloc_array<T>(hp, count)
  match made {
    Err(code) { return Err<Block<T>,u32>(code) }
    Ok(nb) {
      var i u64 = 0u64
      for i < b.count {
        let w u32 = raw.write<T>(nb.addr + i * size, raw.read<T>(b.addr + i * size))
        i = i + 1u64
      }
      let released = free<T>(hp, b)
      match released {
        Ok(n) { return Ok<Block<T>,u32>(nb) }
        Err(code) { return Err<Block<T>,u32>(code) }
      }
    }
  }
}

// Growth of the backing range: the platform made more memory available after `limit`. The limit can only grow and must not wrap.
pub func extend(hp BorrowMut<Heap>, new_limit u64) Result<u64,u32> !{memory.raw} {
  let v Heap = resource.peek(hp)
  let h Header = header(v.h)
  if h.magic != magic() { return Err<u64,u32>(10u32) }
  if new_limit < h.limit { return Err<u64,u32>(5u32) }
  let w u32 = raw.write<Header>(v.h, Header { magic: h.magic, brk: h.brk, limit: new_limit, serial: h.serial, free_head: h.free_head, live: h.live, spare0: 0u64, spare1: 0u64 })
  return Ok<u64,u32>(new_limit)
}

// Teardown: zeroes the carved area, leaves the retired mark and the last serial in the header (nothing else) and consumes the resource. Returns the number of blocks that were still live (a leak report: 0 for a clean program).
pub func destroy(hp Resource<Heap>) u64 !{memory.raw} {
  let v Heap = resource.unseal(move(hp))
  let h Header = header(v.h)
  var left u64 = 0u64
  var last u64 = 0u64
  var mark u64 = 0u64
  if h.magic == magic() {
    left = h.live
    last = h.serial
    mark = retired()
    let z u32 = scrub(v.h + 64u64, h.brk)
  }
  let w u32 = raw.write<Header>(v.h, Header { magic: mark, brk: 0u64, limit: 0u64, serial: last, free_head: 0u64, live: 0u64, spare0: 0u64, spare1: 0u64 })
  return left
}
