module language_usable_recovery_service

func persist(body Text) u32 !{fs.write} {
    match host.write("__STATE__", bytes.from_text(body)) {
        Err(code) { return code }
        Ok(written) { if written != 12u32 { return 92u32 } return 0u32 }
    }
}

func concurrency_gate() u32 {
    task_scope {
        spawn left = 20u32 + 2u32;
        spawn right = 10u32 + 10u32;
        let left_result = join(left)
        match left_result {
            Err(code) { return code }
            Ok(left_value) {
                let right_result = join(right)
                match right_result {
                    Err(code) { return code }
                    Ok(right_value) {
                        if (left_value + right_value) != 42u32 { return 90u32 }
                        return 0u32
                    }
                }
            }
        }
    }
}

func main() u32 !{fs.read,fs.write} {
    let concurrent = concurrency_gate()
    if concurrent != 0u32 { return concurrent }
    match host.read("__STATE__", 64u32) {
        Err(code) { return code }
        Ok(previous) {
            if bytes.len(previous) == 0u32 { return persist("generation=1") }
            if bytes.len(previous) != 12u32 { return 91u32 }
            return persist("generation=2")
        }
    }
}
